# ai/.env로 복사해 값을 채운다. 비워 두면 config.py의 기본값(로컬 compose 기준)을 쓴다.
DATABASE_URL=
REDIS_URL=
BACKEND_BASE_URL=
# OpenAI 호환 API. LLM_MODEL이 비어 있으면 모델을 부르는 요청은 실패한다
LLM_BASE_URL=
LLM_MODEL=
# 키가 필요 없는 서버면 아무 값이나 넣는다
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
# json_schema, function_calling, json_mode 중 하나
LLM_STRUCTURED_OUTPUT=
# 도구 루프 Agent가 질문 하나에 모델을 부르는 최대 횟수. 서버가 도구 호출(tool_choice=required)을 지원해야 한다
LLM_AGENT_MAX_CALLS=
