# ai/.env로 복사해 값을 채운다. 비워 두면 config.py의 기본값(로컬 compose 기준)을 쓴다.
DATABASE_URL=
REDIS_URL=
BACKEND_BASE_URL=
# local: 로컬 Gemma / openai: OpenAI / custom: 아래 기존 LLM_* 직접 설정
LLM_PROFILE=custom
# 로컬 설정 (OpenAI 설정과 함께 보관하고 LLM_PROFILE로 선택한다)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=gemma4:e4b
LOCAL_LLM_API_KEY=ollama
# OpenAI 설정. 키는 여기에 한 번만 넣고 POSTER_LLM_MODEL은 비워 기본 모델을 함께 사용한다.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
# custom 프로필용 기존 OpenAI 호환 API 설정
LLM_BASE_URL=
LLM_MODEL=
# 키가 필요 없는 서버면 아무 값이나 넣는다
LLM_API_KEY=
# 문서 정제 전용 OpenAI 키. 공통 연결이 OpenAI면 비워도 된다.
DOCUMENT_NORMALIZATION_API_KEY=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=
# json_schema, function_calling, json_mode 중 하나
LLM_STRUCTURED_OUTPUT=
# 도구 루프 Agent가 질문 하나에 모델을 부르는 최대 횟수. 서버가 도구 호출(tool_choice=required)을 지원해야 한다
LLM_AGENT_MAX_CALLS=
# 호출 한 번의 최대 출력 토큰 (기본 16384)
LLM_MAX_TOKENS=
# 0이면 같은 질문에 같은 답 (기본 0). temperature를 받지 않는 모델(gpt-6-luna 등)은 none으로 둔다
LLM_TEMPERATURE=
# 추론 강도. 비우면 모델 기본값, none이면 추론을 끈다 (서버가 지원할 때만).
LLM_REASONING_EFFORT=
# OpenRouter 전용. 요청을 보낼 업체를 쉼표로 적는다 (예: baidu,coreweave). 비우면 OpenRouter가 고른다
LLM_PROVIDERS=
# true면 tests/eval의 실제 모델 평가를 돌린다
LLM_EVAL=
POSTER_REFERENCES_PATH=
POSTER_REFERENCE_IMAGES_PATH=
# 포스터 텍스트 설계 전용 OpenAI 키. 이미지는 OpenAI API로 생성하지 않는다.
POSTER_API_KEY=
# 비우면 기본 LLM_MODEL(예: 로컬 Gemma)을 사용한다. 선택적으로 gpt-6-luna 지정 가능.
POSTER_LLM_MODEL=
# GPU 전용 Python 환경과 다운로드한 Z-Image-Turbo 폴더. 비우면 배너 생성 생략.
POSTER_LOCAL_MODEL_PATH=
POSTER_LOCAL_PYTHON=
POSTER_LOCAL_IMAGE_CACHE=.local/poster-images
POSTER_LOCAL_IMAGE_TIMEOUT=300
# 같은 GPU에서 Gemma → Z-Image 순서로 실행할 때 true. Ollama 프로세스는 유지한다.
POSTER_LOCAL_RELEASE_OLLAMA=false
# true면 모델을 부르는 요청 · 작업을 LangSmith에 기록한다 (기본 false). 키는 smith.langchain.com에서 받는다.
# 지시와 자료(지원 문서 본문 포함)가 외부 서버로 나가므로 가상 지원자로 개발 · 평가할 때만 켠다
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
# 기록을 모아 볼 프로젝트 (기본 hiremate)
LANGSMITH_PROJECT=
# 지원서 분석 한 번의 시간 한도(초, 기본 1000). 판정 기준 초안 · 성과 수치 다시 찾기까지 하면 몇 분 걸린다
APPLICATION_TIMEOUT_SECONDS=
# 지원서 워커만 OpenRouter Batch로 실행한다. Chat과 다른 작업의 LLM_MODEL은 유지한다.
# 활성화 시 모델 deepseek/deepseek-v4.1-flash, 제공자 sail-research, 추론 none을 쓴다.
# 비활성화하면 신규 작업은 즉시 분석하며 이미 제출하거나 옮긴 배치 작업은 마저 처리한다.
APPLICATION_BATCH_ENABLED=
APPLICATION_BATCH_MODEL=
APPLICATION_BATCH_PROVIDER=
# 최초 호출을 모으는 시간(기본 5초)과 한 묶음의 최대 호출 수(기본 32)
APPLICATION_BATCH_COLLECTION_SECONDS=
APPLICATION_BATCH_MAX_REQUESTS=
# 결과 조회 간격(기본 60초)과 HTTP 요청 한 번의 한도(기본 30초)
APPLICATION_BATCH_POLL_SECONDS=
APPLICATION_BATCH_HTTP_TIMEOUT_SECONDS=
# 전체 분석 중단 한도(기본 259200초 = 72시간). 완료 시간의 보장은 아니다.
APPLICATION_BATCH_TIMEOUT_SECONDS=
# 지원서 배치 워커가 동시에 맡는 작업 수(기본 4). 다른 작업은 WORKER_CONCURRENCY를 쓴다.
APPLICATION_BATCH_CONCURRENCY=
# AI 워커가 동시에 처리하는 작업 수(기본 1)와 작업 하나의 시도 횟수(기본 2)
WORKER_CONCURRENCY=
WORKER_ATTEMPTS=
# NCS 질의 임베딩 서비스 주소(기본 http://127.0.0.1:8002)와 요청 한 번의 한도(기본 5초). 꺼져 있으면 공고 수정은 NCS 없이 진행한다
# 지원자 프로필 임베딩과 검색도 같은 내부 서비스를 쓴다. 서비스가 꺼져 있거나 색인이 빠지면 검색 결과에 안내한다.
NCS_EMBED_URL=
NCS_EMBED_TIMEOUT_SECONDS=
# 공고 수정의 NCS 참고(검색어 만들기와 검색) 전체 한도(기본 20초). 넘으면 NCS 없이 진행한다
NCS_REFERENCE_TIMEOUT_SECONDS=
# 서비스(uv run --group ncs python -m hiremate_ai.ncs_search)가 듣는 주소(기본 127.0.0.1:8002). 내부망 밖에 열지 않는다
NCS_EMBED_HOST=
NCS_EMBED_PORT=
# 질의 임베딩 모델(기본 BAAI/bge-m3, 로컬 경로 가능)과 장치(cpu, mps, cuda 중 하나, 기본 cpu)
NCS_MODEL=
NCS_DEVICE=
