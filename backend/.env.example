# Canva Developer Portal > Outside Canva > Configuration > Credentials
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Register this exact URI in Outside Canva > Redirect URLs.
CANVA_REDIRECT_URI=http://127.0.0.1:5173/api/companies/me/canva/callback
CANVA_RETURN_URI=http://127.0.0.1:5173/hr/settings/posting
# Templated public gallery (read-only; rendering stays in HireMate).
TEMPLATED_API_KEY=
# Optional administrator-approved generic designs only, never company-private posters.
TEMPLATED_TEMPLATE_IDS=
# Administrator-approved generic Orshot Studio templates only. Search is read-only;
# applying a candidate renders its text-free header once and consumes one render credit.
ORSHOT_API_KEY=
ORSHOT_TEMPLATE_IDS=
# UUIDs of recruitments containing fictional applicants only, separated by commas.
HIREMATE_DEMO_PHOTO_RECRUITMENTS=
